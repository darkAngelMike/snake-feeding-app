{
  "name": "snake-app-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:backend": "npm --prefix server start",
    "start:frontend": "npm --prefix client run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:desktop": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:allure": "allure generate allure-results --clean -o allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.3",
    "typescript": "^5.9.3"
  }
}
